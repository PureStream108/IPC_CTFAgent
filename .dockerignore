.git
# Unanchored so nested caches are excluded too. A bare "__pycache__" only
# matches the repository root, which let bytecode for deleted modules (a stale
# claude_runner.pyc, for one) ride into the image alongside the real sources.
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
coverage.json
.venv
.env
.env.*
.qa-artifacts/
testconfigkey.txt
backend/config/config.yaml
tools/
data/
logs/
wp/
Wp/
projects/
memory/
exports/
ipc_check.js
log.txt
